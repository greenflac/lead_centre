# Рабочий артефакт прогонов, в истории ему не место.
data/store_offline.json

# Кэши ответов модели (data/extract_cache.json, data/translit_cache.json) НЕ игнорируются
# намеренно: с ними прогон eval в режиме llm и транслитерация повторяются без сети и без
# денег. Раньше extract_cache.json стоял здесь и при этом был закоммичен — игнор не
# действует на уже отслеживаемые файлы, поэтому запись просто вводила в заблуждение.

# Скачанные пакеты: в репозитории им не место (однажды сюда приехало колесо на 5.3 МБ).
*.whl
*.tar.gz

# Метаданные сборки от `pip install -e .`: порождаются установкой, в истории им не место.
*.egg-info/

# Локальная конфигурация MCP: содержит идентификатор проекта.
.mcp.json

# Рабочие черновики агентов: в репозитории им не место.
scratchpad/

# Рабочие журналы передачи — остаются в ветке worklog/, не в релизе
HANDOFF_*.md

# Виртуальные окружения Python: ставятся локально, в репозитории им не место.
.venv/
venv/

# Служебное от файловых менеджеров ОС.
.DS_Store
Thumbs.db

# журнал вызовов харнеса (ledger/gates/**/*.jsonl) коммитится: это подписанное
# свидетельство «хуки отработали» — решение владельца 2026-09-19 после сессии,
# которая отработала с хуками и не оставила следа в git.
