# Скопируйте в .env и заполните. Без ключей проект работает в офлайн-режиме:
# движок, тесты и демонстрационные данные не требуют сети.

# --- модель -----------------------------------------------------------------
# Ключ Anthropic. Читаются оба имени, достаточно одного.
CLAUDE_KEY=
ANTHROPIC_API_KEY=
# anthropic (по умолчанию) или pollinations — OpenAI-совместимый шлюз.
LLM_PROVIDER=anthropic
# Задаёт модель вручную и отключает маршрутизацию по длине обращения.
# Пусто — короткие обращения идут на Haiku 4.5, длинные на Opus 5.
LLM_MODEL=
LLM_EFFORT=low
LLM_THINKING=off
POLLINATIONS_API_KEY=

# --- хранилище --------------------------------------------------------------
# Пусто — работает локальное хранилище в data/. Заполнено — Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# local | supabase — перебивает выбор по умолчанию.
LEADCENTRE_STORE=

# --- CRM --------------------------------------------------------------------
# null (по умолчанию, ничего не отправляет) или hubspot.
CRM_SINK=null
# Токен Private App: crm.objects.contacts.*, crm.objects.companies.*
HUBSPOT_PERSONAL_KEY=

# --- режим ------------------------------------------------------------------
# 1 — сеть не трогаем совсем: только кэш и локальное хранилище.
OFFLINE=0
